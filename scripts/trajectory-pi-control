#!/usr/bin/env python3
"""TrajectoryOS Pi runtime control (V1.73-V1.80).

Deterministic, local-only control surface for recorded ``trajectory-pi``
runs.  This tool **inspects** runs, **classifies** whether a run is safe to
target, and performs **bounded graceful stops**.  It never:

* sends SIGKILL (a grace timeout is reported, never escalated);
* talks to any provider, network, or daemon;
* mutates anything outside the selected run directory or the runs-root
  audit trail file (control actions only — never passive reads);
* starts, resumes or re-schedules anything (stop is the only action).

Commands
--------
  list    show the control view (V1.73 targetability + V1.76 recovery)
          for every run in the runs root;
  status  show the full control view for one run (default: most recent);
  stop    send SIGTERM to the run's verified agent process and wait a
          bounded grace period (default 10s); report STOPPED (exit 0) or
          GRACE_TIMEOUT (exit 3) with reasons.

V1.77 hardening
---------------
* ``--run`` selection is explicit and fail-closed: a bare run name resolves
  **only** under the runs root (no CWD fallback, so a same-named directory
  elsewhere can never be picked); an explicit path must resolve **inside**
  the runs root (escaping it is a usage error, never a target).
* ``--grace`` must be a finite, non-negative number of seconds (usage error
  otherwise); negative or NaN grace windows are impossible.
* stdout carries exactly the rendered payload, stderr exactly diagnostics;
  repeated passive reads with fixed input and clock are byte-identical.

V1.78 structured results
------------------------
Every command's JSON payload embeds a stable ``result`` envelope
(``trajectory-pi-control-result/1``) with a fixed, ordered field set:
command, run_id, outcome, requested/performed action, target state,
targetability, target pid, identity and lifecycle evidence, signal and
grace facts, lock outcome, and a deterministic generated_at tag.  Unknown
facts are JSON ``null`` — never omitted, never invented.

V1.79 bounded audit trail
-------------------------
Control actions (``stop`` and its refusals) append sanitized records to a
bounded, local trail at ``<runs-root>/control-audit.jsonl`` (mode 0600,
bounded to the newest 256 records, records constrained to a strict
allow-list so secrets, tokens and environment values cannot enter it).
Passive reads (``list``/``status``) are never audited and never write it.
A trail write failure reports ``audit=unavailable`` and never changes the
control decision that has already been determined.

Fail-closed semantics
---------------------
A run is *stoppable* only when ALL hold (see
``trajectory_os.runtime_control``): recorded pid present, state observed
``running``/``stale``, process alive, cwd and start-time identity verified
against the run's recorded workspace, and the pid is not in this tool's own
process tree.  Any missing fact -> not stoppable, with the precise reason
(exit 2).  With no ``--run``, at most one stoppable run may exist among all
runs, otherwise the stop is refused (ambiguous or absent target).

Exit codes
----------
  0  list/status/stopped-ok
  2  not stoppable / no safe target / ambiguous target (fail closed)
  3  grace timeout: SIGTERM delivered but the process did not exit
  5  lock conflict: another live holder owns the run's control lock
  6  corrupt lock: the lock file is unreadable (fail closed, never guessed)
  64 usage error (invalid subcommand/option, invalid --grace, unknown run,
     no runs found, run path escaping the runs root)

The tool is deterministic: with the same runs-root contents, clocks and a
bounded grace window, its JSON output is a pure function of those inputs.
"""

from __future__ import annotations

import argparse
import json
import math
import os
import sys
import time
from pathlib import Path


def _load_core():
    """Import the core, bootstrapping ``src/`` for plain-python invocations."""
    try:
        from trajectory_os import runtime_control as rc
    except ModuleNotFoundError:
        src = str(Path(__file__).resolve().parents[1] / "src")
        if src not in sys.path:
            sys.path.insert(0, src)
        import importlib

        rc = importlib.import_module("trajectory_os.runtime_control")
    return rc


RC = _load_core()


def _run_names(runs_root: Path) -> list[str]:
    if not runs_root.is_dir():
        return []
    return [
        entry.name
        for entry in runs_root.iterdir()
        if entry.is_dir() and RC.RUN_DIR_RE.fullmatch(entry.name)
    ]


def _usage(message: str):
    print(f"trajectory-pi-control: {message}", file=sys.stderr)
    raise SystemExit(64)


# V1.77: explicit, fail-closed run selection (no accidental targets).
def _resolve_run(runs_root: Path, run: str | None) -> Path:
    """Resolve ``--run`` to a run directory **under** the runs root.

    * a bare run name resolves only under the runs root — a same-named
      directory in the CWD or elsewhere can never be picked by accident;
    * an explicit path must resolve *inside* the runs root; escaping it is
      a usage error, never a target;
    * the target must be a directory matching the run-name format.
    """
    if run is not None:
        looks_like_path = any(sep in run for sep in (os.sep, "/")) or os.path.isabs(run)
        candidate = Path(run) if looks_like_path else runs_root / run
        if not (candidate.is_dir() and RC.RUN_DIR_RE.fullmatch(candidate.name)):
            _usage(f"unknown run: {run!r}")
        try:
            candidate.resolve().relative_to(runs_root.resolve())
        except (ValueError, OSError):
            _usage(f"unknown run: {run!r} (outside runs root: {runs_root})")
        return candidate
    names = _run_names(runs_root)
    if not names:
        _usage(f"no runs found under {runs_root}")
    return runs_root / max(names)


def _self_pid_tree() -> tuple[int, ...]:
    pid = os.getpid()
    return (pid, *RC.ancestor_chain(pid))


def _view(run_dir: Path, now_epoch: float | None) -> RC.RunControlView:
    return RC.evaluate_run(run_dir, now_epoch=now_epoch, own_pids=_self_pid_tree())


def _emit(payload: dict[str, object], human: str, as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(human)


# ---------------------------------------------------------------------------
# V1.78 — structured result envelope (single construction point, stable keys)
# ---------------------------------------------------------------------------


def _result(args: argparse.Namespace, *, now_tag: bool, **kw: object) -> dict[str, object]:
    """Build the fixed-shape V1.78 result envelope for one operation."""
    command = args.command[0] if args.command else "status"
    return RC.build_result(
        command=command,
        generated_at=args.now_tag if now_tag else None,
        **kw,
    )


def _result_identity(view: RC.RunControlView) -> dict[str, object] | None:
    return {"state": view.identity.state, "reasons": list(view.identity.reasons)}


def _result_lifecycle(run_dir: Path, view: RC.RunControlView) -> dict[str, object]:
    meta = RC.parse_meta(run_dir / "meta.txt")
    return {
        "state": view.state,
        "reasons": list(view.state_reasons),
        "started_at": meta.get("started_at"),
        "ended_at": meta.get("ended_at"),
    }


# ---------------------------------------------------------------------------
# V1.79 — audit trail (control actions only; never passive reads)
# ---------------------------------------------------------------------------


def _audit_stop(args: argparse.Namespace, runs_root: Path, record: dict[str, object]) -> str:
    base: dict[str, object] = {
        "ts": args.now_tag,
        "component": "trajectory-pi-control",
        "command": "stop",
        "runs_root": str(runs_root),
        **record,
    }
    return RC.append_audit_record(runs_root, base)


# ---------------------------------------------------------------------------
# subcommand implementations
# ---------------------------------------------------------------------------


def cmd_list(args: argparse.Namespace) -> int:
    runs_root = Path(args.runs_root)
    views = []
    for name in sorted(_run_names(runs_root)):
        view = _view(runs_root / name, args.now)
        views.append({"name": name, "control": view.to_dict()})
    payload = {
        "schema": f"trajectory-pi-control/{RC.CONTROL_CORE}",
        "command": "list",
        "runs_root": str(runs_root),
        "generated_at": args.now_tag,
        "runs": views,
        "result": _result(
            args,
            now_tag=False,
            outcome="OK",
            audit=None,
            evidence_source="runs-root",
        ),
    }
    human = f"runs under {runs_root}: {len(views)}"
    for item in views:
        ctrl = item["control"]
        human = (
            human
            + f"\n  {item['name']}  state={ctrl['state']} "
            f"targetable={'yes' if ctrl['targetable_safe'] else 'no'} "
            f"stoppable={'yes' if ctrl['stoppable'] else 'no'} "
            f"recovery={'ready' if ctrl['recovery']['ready'] else 'not-ready'}"
        )
    _emit(payload, human, args.json)
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    runs_root = Path(args.runs_root)
    run_dir = _resolve_run(runs_root, args.run)
    view = _view(run_dir, args.now)
    payload = {
        "schema": f"trajectory-pi-control/{RC.CONTROL_CORE}",
        "command": "status",
        "runs_root": str(runs_root),
        "generated_at": args.now_tag,
        "run": run_dir.name,
        "control": view.to_dict(),
        "result": _result(
            args,
            now_tag=False,
            outcome="OK",
            run_id=run_dir.name,
            target_state=view.state,
            targetable=view.targetable,
            stoppable=view.stoppable,
            target_pid=view.target_pid,
            identity=_result_identity(view),
            lifecycle=_result_lifecycle(run_dir, view),
            evidence_source="run-directory",
        ),
    }
    c = view.to_dict()
    human = (
        f"run {run_dir.name}\n"
        f"  state={c['state']} ({', '.join(c['state_reasons']) or 'n/a'})\n"
        f"  identity={c['identity']['state']} "
        f"({', '.join(c['identity']['reasons']) or 'n/a'})\n"
        f"  targetable_safe={'yes' if c['targetable_safe'] else 'no'} "
        f"({', '.join(c['targetable_reasons']) or 'n/a'})\n"
        f"  stoppable={'yes' if c['stoppable'] else 'no'} "
        f"({', '.join(c['stoppable_reasons']) or 'n/a'})\n"
        f"  recovery.ready={'yes' if c['recovery']['ready'] else 'no'} "
        f"({', '.join(c['recovery']['reasons']) or 'n/a'})"
    )
    if c.get("resume_hint") is not None:
        human += f"\n  resume_hint={json.dumps(c['resume_hint'], sort_keys=True)}"
    _emit(payload, human, args.json)
    return 0


def _stop_reject(
    args: argparse.Namespace,
    runs_root: Path,
    *,
    outcome: str,
    reasons: list[str],
    run_dir: Path | None,
    view: RC.RunControlView | None,
    human: str,
    lock: str | None = None,
    audit: bool = True,
    exit_code: int = 2,
) -> int:
    """One deterministic, audited refusal for a stop attempt (V1.77-V1.79)."""
    result = _result(
        args,
        now_tag=True,
        outcome=outcome,
        reasons=reasons,
        action_requested="stop",
        action_performed=None,
        run_id=run_dir.name if run_dir is not None else None,
        target_state=view.state if view is not None else None,
        targetable=view.targetable if view is not None else None,
        stoppable=view.stoppable if view is not None else None,
        target_pid=view.target_pid if view is not None else None,
        lock=lock,
        grace_seconds=args.grace,
        identity=_result_identity(view) if view is not None else None,
        lifecycle=(
            _result_lifecycle(run_dir, view)
            if run_dir is not None and view is not None
            else None
        ),
        evidence_source="run-directory" if run_dir is not None else "runs-root",
    )
    if audit:
        result["audit"] = _audit_stop(
            args,
            runs_root,
            {
                "decision": "refused",
                "outcome": outcome,
                "reasons": reasons,
                "refusal_reason": reasons[0] if reasons else None,
                "action": "stop",
                "run_id": result["run_id"],
                "target_pid": result["target_pid"],
                "identity_state": result["identity"]["state"] if result["identity"] else None,
                "lock": lock,
                "grace_seconds": args.grace,
            },
        )
    print(f"stop refused: {outcome} ({', '.join(reasons) or 'n/a'})", file=sys.stderr)
    _emit(
        {
            "schema": f"trajectory-pi-control/{RC.CONTROL_CORE}",
            "command": "stop",
            "outcome": outcome,
            "reasons": reasons,
            "run": result["run_id"],
            "target_pid": result["target_pid"],
            "lock": lock,
            "result": result,
        },
        human,
        args.json,
    )
    return exit_code


def cmd_stop(args: argparse.Namespace) -> int:
    runs_root = Path(args.runs_root)
    grace = float(args.grace)
    as_json = args.json

    if args.run is None:
        # Resolve the unique safe target across the whole runs root.
        stoppable: list[tuple[str, RC.RunControlView]] = []
        for name in sorted(_run_names(runs_root)):
            view = _view(runs_root / name, args.now)
            if view.stoppable:
                stoppable.append((name, view))
        if len(stoppable) == 0:
            return _stop_reject(
                args,
                runs_root,
                outcome="REJECTED",
                reasons=["no-stoppable-run-in-runs-root"],
                run_dir=None,
                view=None,
                human=(
                    "stop rejected: no stoppable run was found in the runs root "
                    "(fail closed; inspect with `list`)"
                ),
            )
        if len(stoppable) > 1:
            names = [n for n, _ in stoppable]
            return _stop_reject(
                args,
                runs_root,
                outcome="REJECTED",
                reasons=[f"ambiguous-target:{len(stoppable)}", *names],
                run_dir=None,
                view=None,
                human=(
                    f"stop rejected (ambiguous-target: {len(stoppable)}): "
                    f"multiple stoppable runs found; select one with --run "
                    f"({', '.join(names)})"
                ),
            )
        name, view = stoppable[0]
        run_dir = runs_root / name
    else:
        run_dir = _resolve_run(runs_root, args.run)
        view = _view(run_dir, args.now)
        if not view.stoppable:
            reasons = list(view.stoppable_reasons) or [f"state-is-{view.state}"]
            return _stop_reject(
                args,
                runs_root,
                outcome="REJECTED",
                reasons=reasons,
                run_dir=run_dir,
                view=view,
                human=(
                    f"stop rejected for {run_dir.name}: {', '.join(reasons)} "
                    "(fail closed; a stale, dead, or unverified target is never signalled)"
                ),
            )

    target = view.target_pid
    if target is None:
        return _stop_reject(
            args,
            runs_root,
            outcome="REJECTED",
            reasons=["no-recorded-pid"],
            run_dir=run_dir,
            view=view,
            human=f"stop rejected for {run_dir.name}: no recorded pid",
        )

    # Run-local control lock: refuse while another live holder is working.
    holder = os.getpid()
    outcome = RC.acquire_control_lock(run_dir, "stop", holder_pid=holder)
    if outcome == "conflict":
        info = RC.read_lock(run_dir)
        return _stop_reject(
            args,
            runs_root,
            outcome="LOCK_CONFLICT",
            reasons=[f"lock-held-by-alive:{info.holder}"],
            run_dir=run_dir,
            view=view,
            lock="conflict",
            exit_code=5,
            human=(
                f"stop rejected for {run_dir.name}: another live control holder "
                f"(pid {info.holder}) owns the run lock"
            ),
        )
    if outcome == "corrupt":
        return _stop_reject(
            args,
            runs_root,
            outcome="LOCK_CORRUPT",
            reasons=["lock-file-corrupt-fail-closed"],
            run_dir=run_dir,
            view=view,
            lock="corrupt",
            exit_code=6,
            human=(
                f"stop rejected for {run_dir.name}: the run lock file is corrupt "
                "(fail closed; a human must inspect the run directory)"
            ),
        )

    RC.append_control_event(
        run_dir,
        event="stop-intent",
        run_id=run_dir.name,
        target_pid=target,
        grace_seconds=grace,
        identity={
            "state": view.identity.state,
            "reasons": list(view.identity.reasons),
        },
        locked_via=outcome,
    )
    sent = RC.send_sigterm(target)
    RC.append_control_event(
        run_dir,
        event="stop-signal-sent",
        run_id=run_dir.name,
        target_pid=target,
        signal="SIGTERM",
        sent=sent,
    )

    deadline = time.monotonic() + max(0.0, grace)
    while not RC.is_pid_terminated(target):
        if time.monotonic() >= deadline:
            break
        time.sleep(0.05)
    stopped = RC.is_pid_terminated(target)

    if stopped:
        outcome_str = "STOPPED"
        exit_code = 0
        note = "graceful stop confirmed: the verified process exited"
    else:
        outcome_str = "GRACE_TIMEOUT"
        exit_code = 3
        note = (
            f"SIGTERM delivered but the process was still alive after "
            f"{grace:.1f}s; no SIGKILL is ever sent by this surface — "
            f"inspect the run manually"
        )
    reasons: list[str] = [] if stopped else [f"grace-timeout:{grace:.1f}s"]
    RC.append_control_event(
        run_dir,
        event="stop-result",
        run_id=run_dir.name,
        target_pid=target,
        outcome=outcome_str,
        note=note,
    )
    RC.release_control_lock(run_dir)

    result = _result(
        args,
        now_tag=True,
        outcome=outcome_str,
        reasons=reasons,
        action_requested="stop",
        action_performed="sigterm-sent" if sent else None,
        run_id=run_dir.name,
        target_state=view.state,
        targetable=view.targetable,
        stoppable=view.stoppable,
        target_pid=target,
        signal_requested="SIGTERM" if sent else None,
        signal_sent=bool(sent),
        lock=outcome,
        grace_seconds=grace,
        identity=_result_identity(view),
        lifecycle=_result_lifecycle(run_dir, view),
        evidence_source="run-directory",
    )
    result["audit"] = _audit_stop(
        args,
        runs_root,
        {
            "decision": "signal",
            "outcome": outcome_str,
            "reasons": reasons,
            "action": "stop",
            "run_id": run_dir.name,
            "target_pid": target,
            "identity_state": view.identity.state,
            "identity_reasons": list(view.identity.reasons),
            "signal_requested": "SIGTERM" if sent else None,
            "signal_sent": bool(sent),
            "lock": outcome,
            "grace_seconds": grace,
        },
    )

    _emit(
        {
            "schema": f"trajectory-pi-control/{RC.CONTROL_CORE}",
            "command": "stop",
            "outcome": outcome_str,
            "reasons": reasons,
            "run": run_dir.name,
            "target_pid": target,
            "grace_seconds": grace,
            "lock": outcome,
            "control": view.to_dict(),
            "result": result,
            "note": note,
        },
        f"{outcome_str}: run {run_dir.name} (target pid {target}); {note}",
        as_json,
    )
    return exit_code


# ---------------------------------------------------------------------------
# argument parsing
# ---------------------------------------------------------------------------


def main(argv: list[str] | None = None) -> int:
    class _Parser(argparse.ArgumentParser):
        def error(self, message: str) -> None:  # usage errors exit 64
            print(f"trajectory-pi-control: {message}", file=sys.stderr)
            raise SystemExit(64)

    root = _Parser(
        prog="trajectory-pi-control",
        description="Deterministic safe-target, graceful-stop and recovery-readiness "
        "control surface for trajectory-pi runs (V1.73-V1.80).",
    )
    root.add_argument(
        "command",
        nargs="*",
        choices=["list", "status", "stop"],
        default=("status",),
        metavar="COMMAND",
        help="list | status | stop (default: status)",
    )
    root.add_argument(
        "--runs-root",
        default=str(Path.cwd() / ".trajectory-pi" / "runs"),
        help="runs root directory (default: <cwd>/.trajectory-pi/runs)",
    )
    root.add_argument(
        "--run",
        default=None,
        help="run name or path (default for status: most recent; "
        "for stop: required when the target is not unique)",
    )
    root.add_argument("--json", action="store_true", help="emit JSON output")
    root.add_argument(
        "--grace", type=float, default=10.0, help="grace seconds after SIGTERM (default 10)"
    )
    root.add_argument("--now", type=float, default=None, help=argparse.SUPPRESS)
    root.add_argument(
        "--now-tag", default=time.strftime("%Y-%m-%dT%H:%M:%S"), help=argparse.SUPPRESS
    )

    args = root.parse_args(argv)

    # V1.77: the grace window must be a finite, non-negative bound.
    if not (math.isfinite(args.grace) and args.grace >= 0.0):
        _usage(f"invalid --grace: {args.grace!r} (must be finite and >= 0)")

    mode = args.command[0] if args.command else "status"
    dispatch = {"list": cmd_list, "status": cmd_status, "stop": cmd_stop}
    return dispatch[mode](args)


if __name__ == "__main__":
    sys.exit(main())
