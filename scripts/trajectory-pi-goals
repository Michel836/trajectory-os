#!/usr/bin/env bash
# trajectory-pi-goals — goal decomposition graph + portfolio scheduler CLI
# (Missions 012/013).
#
# Thin, stable shim over src/trajectory_os/graph.  It only resolves the
# repository root, prepends the src layout to PYTHONPATH and execs the
# operator CLI: `python3 -m trajectory_os.graph.cli "$@"`.
#
# Subcommands:
#   create     create one goal graph from a bounded declarative JSON spec
#   show       full graph state (goal, size, order, readiness, provenance)
#   nodes      list normalized nodes with readiness state
#   edges      list explicit dependency edges
#   order      deterministic topological order
#   ready      dependency-ready / eligible nodes
#   blocked    dependency-blocked nodes with reasons
#   why        explain one node's dependency-block state
#   project    machine-readable M013 scheduler-facing projection
#   validate   reconstruct + revalidate persisted graph state
#   list       all goal graphs under the root
#   capacity   configured scheduler capacity (+ live reservation status)
#   preview    deterministic scheduling preview (never persists/dispatches)
#   schedule   run one scheduling cycle and persist the decision
#   dispatch   run one cycle and dispatch admitted work via the mission path
#   portfolio  compact human-readable portfolio summary
#   resources  active/reserved scheduler resources
#   history    append-only scheduling decision history
#   why-schedule       explain one node's scheduling outcome
#   validate-schedule  reconstruct + revalidate scheduler state
#   reuse              inspect the resolved cross-mission reuse projection
#   reuse-resolve      resolve + persist the reuse projection
#   reuse-validate     reconstruct + revalidate the persisted projection
#   reuse-history      append-only cross-mission consumption history
#   why-reuse          explain one node's reuse inputs
#   provenance         explicit producer -> consumer reuse provenance
#   replan-preview     build + validate an adaptive replan plan (read-only)
#   replan-apply       activate a validated replan generation
#   current-generation current validated graph generation (alias: generation)
#   replan-history     append-only replan event history
#   replan-why         explain one node's replan evolution
#   replan-validate    reconstruct + revalidate persisted replan state
#   replan-project     machine-readable M016 replanning projection
#   adopt-generation   re-bind scheduler state to the newest generation
#   goal               compact goal-level proof dashboard (alias: dashboard)
#   goal-proof         full machine-readable goal-level proof projection
#   goal-explain       deterministic why/explain for the goal or a node
#   goal-criteria      acceptance criteria and their exact evidence
#   goal-risks         unresolved/blocked/stale/legacy/unproven risks
#   goal-record        record + persist one derived goal-proof snapshot
#   goal-validate      reconstruct + revalidate the persisted goal proof
#   goal-history       append-only goal-proof event history
#   version
#
# Exit codes: 0 ok, 2 usage, 3 rejected, 4 unknown goal.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")" && pwd -P)"
ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
SRC="${ROOT}/src"

if [[ ! -d "${SRC}/trajectory_os/graph" ]]; then
  printf 'trajectory-pi-goals: internal error: missing trajectory_os/graph package (expected %s)\n' "${SRC}/trajectory_os/graph" >&2
  exit 2
fi

if [[ ! -d "${SRC}/trajectory_os/graph/scheduler" ]]; then
  printf 'trajectory-pi-goals: internal error: missing trajectory_os/graph/scheduler package (expected %s)\n' "${SRC}/trajectory_os/graph/scheduler" >&2
  exit 2
fi

if [[ ! -d "${SRC}/trajectory_os/graph/reuse" ]]; then
  printf 'trajectory-pi-goals: internal error: missing trajectory_os/graph/reuse package (expected %s)\n' "${SRC}/trajectory_os/graph/reuse" >&2
  exit 2
fi

if [[ ! -d "${SRC}/trajectory_os/graph/replan" ]]; then
  printf 'trajectory-pi-goals: internal error: missing trajectory_os/graph/replan package (expected %s)\n' "${SRC}/trajectory_os/graph/replan" >&2
  exit 2
fi

if [[ ! -d "${SRC}/trajectory_os/graph/proof" ]]; then
  printf 'trajectory-pi-goals: internal error: missing trajectory_os/graph/proof package (expected %s)\n' "${SRC}/trajectory_os/graph/proof" >&2
  exit 2
fi

export PYTHONPATH="${SRC}${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m trajectory_os.graph.cli "$@"
